properties([
    parameters([
        string(defaultValue: 'variables.tfvars', description: 'Specify the file name', name: 'Varfile'),
        choice(choices: ['plan', 'apply', 'destroy'], description: 'Select Terraform action', name: 'Terraform-Action')
    ])
])

pipeline {
    agent any
    stages {
        stage('Checkout from Git') {
            steps {
                git branch: 'main', url: 'https://github.com/Krishnendu-1/Prod-DevSecOps.git'
            }
        }
        stage('Initializing Terraform') {
            steps {
                withAWS(credentials: 'accessKey', region: 'ap-south-1') {
                dir('EKS') {
                    script {
                        sh 'terraform init'
                    }
                }
                }
            }
        }
        stage('Validate Terraform Code') {
            steps {
                withAWS(credentials: 'accessKey', region: 'ap-south-1') {
                dir('EKS') {
                    script {
                        sh 'terraform validate'
                    }
                }
                }
            }
        }
        stage('Terraform Plan') {
            steps {
                withAWS(credentials: 'accessKey', region: 'ap-south-1') {
                dir('EKS') {
                    script {
                        sh "terraform plan -var-file=${params.Varfile}"
                    }
                }
                }
            }
        }
        stage('Terraform Action') {
            steps {
                withAWS(credentials: 'accessKey', region: 'ap-south-1') {
                script {
                    echo "${params.'Terraform-Action'}"
                    dir('EKS') {
                        script {
                            if (params.'Terraform-Action' == 'plan') {
                                sh "terraform plan -var-file=${params.Varfile}"
                            } else if (params.'Terraform-Action' == 'apply') {
                                sh "terraform apply -auto-approve -var-file=${params.Varfile}"
                            } else if (params.'Terraform-Action' == 'destroy') {
                                sh "terraform destroy -auto-approve -var-file=${params.Varfile}"
                            } else {
                                error "Invalid value for Terraform-Action: ${params.'Terraform-Action'}"
                            }
                        }
                    }
                }
                }
            }
        }
    }
}